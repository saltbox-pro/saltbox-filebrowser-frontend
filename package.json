{
  "name": "saltbox-filesystem-frontend",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "scripts": {
    "start": "webpack serve --config webpack.dev.config.js --mode=development",
    "build": "yarn clean && webpack --mode=production",
    "build:dev": "yarn clean && webpack --config webpack.dev.config.js --mode=development",
    "lint:types": "tsc --noEmit",
    "lint:code": "eslint src",
    "lint": "yarn lint:types && yarn lint:code",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "prepare": "husky",
    "live": "npx http-server ./dist -p 4206 --cors",
    "clean": "npx rimraf ./dist"
  },
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@babel/eslint-parser": "^7.23.3",
    "@babel/plugin-transform-runtime": "^7.23.3",
    "@babel/preset-env": "^7.23.3",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "7.23.3",
    "@babel/runtime": "^7.23.3",
    "@eslint/compat": "^1.2.4",
    "@eslint/eslintrc": "^3.1.2",
    "@eslint/js": "^9.39.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/systemjs": "^6.1.1",
    "@types/webpack-env": "^1.16.2",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "babel-jest": "^27.5.1",
    "concurrently": "^6.2.1",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-ts-react-important-stuff": "^3.0.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "monaco-editor-webpack-plugin": "^7.1.1",
    "prettier": "^3.7.4",
    "pretty-quick": "^4.2.2",
    "ts-config-single-spa": "^3.0.0",
    "typescript": "^5.9.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^4.10.0",
    "webpack-config-single-spa-react-ts": "^8.0.0",
    "webpack-dev-server": "^4.0.0",
    "webpack-merge": "^5.8.0"
  },
  "dependencies": {
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-proposal-decorators": "7.28.0",
    "@material-symbols/font-300": "^0.38.0",
    "@monaco-editor/react": "^4.7.0",
    "@saltbox/saltbox-frontend-common": "^0.3.17",
    "@tanstack/react-table": "^8.21.3",
    "antd": "5.26.0",
    "i18next": "25.5.0",
    "i18next-browser-languagedetector": "8.2.0",
    "mobx": "6.13.7",
    "mobx-react": "9.1.0",
    "monaco-editor": "^0.55.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-error-boundary": "^6.1.2",
    "react-i18next": "15.7.4",
    "react-router": "^7.8.2",
    "single-spa": "^5.9.3",
    "single-spa-react": "^6.0.2"
  },
  "resolutions": {
    "typescript": "^5.9.3"
  }
}
